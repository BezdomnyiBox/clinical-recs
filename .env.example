MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=clinical
MYSQL_USER=clinical
MYSQL_PASSWORD=change_me
DATABASE_URL=mysql+pymysql://clinical:change_me@mysql:3306/clinical?charset=utf8mb4
# Провайдер: openrouter или iacpaas
LLM_PROVIDER=iacpaas
# Вставьте полный ключ в локальный .env; не публикуйте его и не добавляйте в Git.
IACPAAS_API_KEY=
IACPAAS_BASE_URL=https://aichat.iacpaas.dvo.ru/api
IACPAAS_MODEL=qwen3.8-27b
LLM_MAX_TOKENS=6000
# Для прежней настройки OpenRouter задайте LLM_PROVIDER=openrouter и OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
UPLOAD_DIR=/data/uploads
